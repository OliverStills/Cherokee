# Email Configuration
# For Gmail: Use your Gmail address and an App Password (not your regular password)
# To create a Gmail App Password: https://support.google.com/accounts/answer/185833

SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password-here
RECIPIENT_EMAIL=recipient@example.com

# SMTP Server Configuration (defaults shown below)
# For Gmail, these defaults should work
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# For other email providers, update accordingly:
# Outlook: smtp-mail.outlook.com, port 587
# Yahoo: smtp.mail.yahoo.com, port 587
